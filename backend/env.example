# Copy this file to .env and update values
# cp env.example .env

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/stewardchms"

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Admin User (for seeding)
ADMIN_EMAIL=admin@stewardchms.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=System Administrator


# ── Platform ────────────────────────────────────────────────────────────────
# Leave both unset for a self-hosted install. A self-hosted Congregation has
# one organization, resolves it without a hostname, and refuses console calls.

# The platform root domain. With this set, the organization is read from the
# request host as {slug}-stewardchms.app.<root>, and any tenant host under the
# root is an allowed CORS origin.
# PLATFORM_ROOT_DOMAIN=stewardgrace.com

# This app's own service token, issued by the console. Only POST
# /api/internal/provision accepts it, and only this app's token — a token
# issued to another Steward product is refused.
# PLATFORM_SERVICE_TOKEN=stw_svc_chms_change-me
