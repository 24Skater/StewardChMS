// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Auth + RBAC Models (Phase 1)
// ============================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  userRoles UserRole[]
  auditLogs AuditLog[] @relation("ActorAuditLogs")
  messages  Message[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  actorUser User? @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// Member CRM Models (Phase 2)
// ============================================

model Member {
  id              String       @id @default(cuid())
  firstName       String       @map("first_name")
  lastName        String       @map("last_name")
  email           String?      @unique
  phone           String?
  street          String?
  city            String?
  state           String?
  zip             String?
  dateOfBirth     DateTime?    @map("date_of_birth")
  status          MemberStatus @default(active)
  notes           String?      // Permission restricted (members.notes)
  profilePhotoUrl String?      @map("profile_photo_url")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  householdMembers  HouseholdMember[]
  registrations     Registration[]
  checkIns          CheckIn[]
  worshipPlanItems  WorshipPlanItem[]
  messageRecipients MessageRecipient[]
  optInPreferences  OptInPreference[]

  @@index([lastName])
  @@index([email])
  @@index([status])
  @@map("members")
}

enum MemberStatus {
  active
  inactive
  visitor
}

model Household {
  id        String   @id @default(cuid())
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  members HouseholdMember[]

  @@map("households")
}

model HouseholdMember {
  id               String           @id @default(cuid())
  householdId      String           @map("household_id")
  memberId         String           @map("member_id")
  relationshipType RelationshipType @map("relationship_type")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([householdId, memberId])
  @@index([householdId])
  @@index([memberId])
  @@map("household_members")
}

enum RelationshipType {
  parent
  child
  spouse
  other
}

// ============================================
// Events Models (Phase 3)
// ============================================

model Event {
  id             String    @id @default(cuid())
  title          String
  description    String?
  location       String?
  category       String?
  ministryId     String?   @map("ministry_id")
  isRecurring    Boolean   @default(false) @map("is_recurring")
  recurrenceRule String?   @map("recurrence_rule")
  startDatetime  DateTime? @map("start_datetime")
  endDatetime    DateTime? @map("end_datetime")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  occurrences EventOccurrence[]

  @@index([category])
  @@index([startDatetime])
  @@map("events")
}

model EventOccurrence {
  id       String           @id @default(cuid())
  eventId  String           @map("event_id")
  startsAt DateTime         @map("starts_at")
  endsAt   DateTime?        @map("ends_at")
  status   OccurrenceStatus @default(scheduled)
  notes    String?

  // Relations
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]
  checkIns      CheckIn[]
  worshipPlan   WorshipPlan?

  @@unique([eventId, startsAt])
  @@index([startsAt])
  @@index([eventId])
  @@map("event_occurrences")
}

enum OccurrenceStatus {
  scheduled
  canceled
}

model Registration {
  id                String             @id @default(cuid())
  eventOccurrenceId String             @map("event_occurrence_id")
  memberId          String?            @map("member_id")
  guestName         String?            @map("guest_name")
  guestEmail        String?            @map("guest_email")
  guestPhone        String?            @map("guest_phone")
  partySize         Int                @default(1) @map("party_size")
  status            RegistrationStatus @default(registered)
  createdAt         DateTime           @default(now()) @map("created_at")

  // Relations
  occurrence EventOccurrence @relation(fields: [eventOccurrenceId], references: [id], onDelete: Cascade)
  member     Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([eventOccurrenceId])
  @@index([memberId])
  @@map("registrations")
}

enum RegistrationStatus {
  registered
  canceled
}

model CheckIn {
  id                String   @id @default(cuid())
  eventOccurrenceId String   @map("event_occurrence_id")
  memberId          String?  @map("member_id")
  guestName         String?  @map("guest_name")
  checkedInAt       DateTime @default(now()) @map("checked_in_at")
  method            String   @default("manual")

  // Relations
  occurrence EventOccurrence @relation(fields: [eventOccurrenceId], references: [id], onDelete: Cascade)
  member     Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([eventOccurrenceId])
  @@index([memberId])
  @@map("check_ins")
}

// ============================================
// Worship Planning Models (Phase 3)
// ============================================

model Song {
  id         String   @id @default(cuid())
  title      String
  artist     String?
  defaultKey String?  @map("default_key")
  bpm        Int?
  lyrics     String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  worshipPlanItems WorshipPlanItem[]

  @@index([title])
  @@map("songs")
}

model WorshipPlan {
  id                String   @id @default(cuid())
  eventOccurrenceId String   @unique @map("event_occurrence_id")
  title             String?
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  occurrence EventOccurrence   @relation(fields: [eventOccurrenceId], references: [id], onDelete: Cascade)
  items      WorshipPlanItem[]

  @@map("worship_plans")
}

model WorshipPlanItem {
  id               String  @id @default(cuid())
  worshipPlanId    String  @map("worship_plan_id")
  sortOrder        Int     @map("sort_order")
  itemType         String  @map("item_type")
  title            String
  details          String?
  songId           String? @map("song_id")
  assignedMemberId String? @map("assigned_member_id")
  durationMinutes  Int?    @map("duration_minutes")

  // Relations
  worshipPlan    WorshipPlan @relation(fields: [worshipPlanId], references: [id], onDelete: Cascade)
  song           Song?       @relation(fields: [songId], references: [id], onDelete: SetNull)
  assignedMember Member?     @relation(fields: [assignedMemberId], references: [id], onDelete: SetNull)

  @@index([worshipPlanId])
  @@index([songId])
  @@map("worship_plan_items")
}

// ============================================
// Communication Models (Phase 4)
// ============================================

enum MessageChannel {
  email
  sms
}

enum DeliveryStatus {
  pending
  sent
  failed
}

model Message {
  id              String         @id @default(cuid())
  channel         MessageChannel
  subject         String?
  body            String
  createdByUserId String         @map("created_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")

  // Relations
  createdByUser User               @relation(fields: [createdByUserId], references: [id])
  recipients    MessageRecipient[]

  @@index([createdAt])
  @@map("messages")
}

model MessageRecipient {
  id             String         @id @default(cuid())
  messageId      String         @map("message_id")
  memberId       String?        @map("member_id")
  guestContact   Json?          @map("guest_contact")
  deliveryStatus DeliveryStatus @default(pending) @map("delivery_status")
  deliveredAt    DateTime?      @map("delivered_at")
  errorMessage   String?        @map("error_message")

  // Relations
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  member  Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([deliveryStatus])
  @@map("message_recipients")
}

model MessageTemplate {
  id        String         @id @default(cuid())
  name      String
  channel   MessageChannel
  subject   String?
  body      String
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("message_templates")
}

model OptInPreference {
  id        String         @id @default(cuid())
  memberId  String         @map("member_id")
  channel   MessageChannel
  isOptedIn Boolean        @default(true) @map("is_opted_in")
  updatedAt DateTime       @updatedAt @map("updated_at")

  // Relations
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, channel])
  @@map("opt_in_preferences")
}
