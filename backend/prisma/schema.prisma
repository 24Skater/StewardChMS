// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Auth + RBAC Models (Phase 1)
// ============================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  userRoles      UserRole[]
  auditLogs      AuditLog[]      @relation("ActorAuditLogs")
  messages       Message[]
  purchaseOrders PurchaseOrder[]
  sales          Sale[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  actorUser User? @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// Member CRM Models (Phase 2)
// ============================================

model Member {
  id              String       @id @default(cuid())
  firstName       String       @map("first_name")
  lastName        String       @map("last_name")
  email           String?      @unique
  phone           String?
  street          String?
  city            String?
  state           String?
  zip             String?
  dateOfBirth     DateTime?    @map("date_of_birth")
  status          MemberStatus @default(active)
  notes           String?      // Permission restricted (members.notes)
  profilePhotoUrl String?      @map("profile_photo_url")
  // Kids Check-in fields
  isChild         Boolean      @default(false) @map("is_child")
  securityCode    String?      @unique @map("security_code")
  allergies       String?
  medicalNotes    String?      @map("medical_notes")
  parentalNotes   String?      @map("parental_notes")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  householdMembers  HouseholdMember[]
  registrations     Registration[]
  checkIns          CheckIn[]
  worshipPlanItems  WorshipPlanItem[]
  messageRecipients MessageRecipient[]
  optInPreferences  OptInPreference[]
  donations         Donation[]
  pledges           Pledge[]
  sales             Sale[]
  groupMemberships  GroupMember[]
  groupLeaderships  GroupLeader[]

  @@index([lastName])
  @@index([email])
  @@index([status])
  @@map("members")
}

enum MemberStatus {
  active
  inactive
  visitor
}

model Household {
  id        String   @id @default(cuid())
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  members HouseholdMember[]

  @@map("households")
}

model HouseholdMember {
  id               String           @id @default(cuid())
  householdId      String           @map("household_id")
  memberId         String           @map("member_id")
  relationshipType RelationshipType @map("relationship_type")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([householdId, memberId])
  @@index([householdId])
  @@index([memberId])
  @@map("household_members")
}

enum RelationshipType {
  parent
  child
  spouse
  other
}

// ============================================
// Events Models (Phase 3)
// ============================================

model Event {
  id             String    @id @default(cuid())
  title          String
  description    String?
  location       String?
  category       String?
  ministryId     String?   @map("ministry_id")
  isRecurring    Boolean   @default(false) @map("is_recurring")
  recurrenceRule String?   @map("recurrence_rule")
  startDatetime  DateTime? @map("start_datetime")
  endDatetime    DateTime? @map("end_datetime")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  occurrences EventOccurrence[]

  @@index([category])
  @@index([startDatetime])
  @@map("events")
}

model EventOccurrence {
  id       String           @id @default(cuid())
  eventId  String           @map("event_id")
  startsAt DateTime         @map("starts_at")
  endsAt   DateTime?        @map("ends_at")
  status   OccurrenceStatus @default(scheduled)
  notes    String?

  // Relations
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]
  checkIns      CheckIn[]
  worshipPlan   WorshipPlan?

  @@unique([eventId, startsAt])
  @@index([startsAt])
  @@index([eventId])
  @@map("event_occurrences")
}

enum OccurrenceStatus {
  scheduled
  canceled
}

model Registration {
  id                String             @id @default(cuid())
  eventOccurrenceId String             @map("event_occurrence_id")
  memberId          String?            @map("member_id")
  guestName         String?            @map("guest_name")
  guestEmail        String?            @map("guest_email")
  guestPhone        String?            @map("guest_phone")
  partySize         Int                @default(1) @map("party_size")
  status            RegistrationStatus @default(registered)
  createdAt         DateTime           @default(now()) @map("created_at")

  // Relations
  occurrence EventOccurrence @relation(fields: [eventOccurrenceId], references: [id], onDelete: Cascade)
  member     Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([eventOccurrenceId])
  @@index([memberId])
  @@map("registrations")
}

enum RegistrationStatus {
  registered
  canceled
}

model CheckIn {
  id                String    @id @default(cuid())
  eventOccurrenceId String    @map("event_occurrence_id")
  memberId          String?   @map("member_id")
  guestName         String?   @map("guest_name")
  checkedInAt       DateTime  @default(now()) @map("checked_in_at")
  checkedOutAt      DateTime? @map("checked_out_at")
  method            String    @default("manual")

  // Relations
  occurrence EventOccurrence @relation(fields: [eventOccurrenceId], references: [id], onDelete: Cascade)
  member     Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([eventOccurrenceId])
  @@index([memberId])
  @@map("check_ins")
}

// ============================================
// Worship Planning Models (Phase 3)
// ============================================

model Song {
  id         String   @id @default(cuid())
  title      String
  artist     String?
  defaultKey String?  @map("default_key")
  bpm        Int?
  lyrics     String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  worshipPlanItems WorshipPlanItem[]

  @@index([title])
  @@map("songs")
}

model WorshipPlan {
  id                String   @id @default(cuid())
  eventOccurrenceId String   @unique @map("event_occurrence_id")
  title             String?
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  occurrence EventOccurrence   @relation(fields: [eventOccurrenceId], references: [id], onDelete: Cascade)
  items      WorshipPlanItem[]

  @@map("worship_plans")
}

model WorshipPlanItem {
  id               String  @id @default(cuid())
  worshipPlanId    String  @map("worship_plan_id")
  sortOrder        Int     @map("sort_order")
  itemType         String  @map("item_type")
  title            String
  details          String?
  songId           String? @map("song_id")
  assignedMemberId String? @map("assigned_member_id")
  durationMinutes  Int?    @map("duration_minutes")

  // Relations
  worshipPlan    WorshipPlan @relation(fields: [worshipPlanId], references: [id], onDelete: Cascade)
  song           Song?       @relation(fields: [songId], references: [id], onDelete: SetNull)
  assignedMember Member?     @relation(fields: [assignedMemberId], references: [id], onDelete: SetNull)

  @@index([worshipPlanId])
  @@index([songId])
  @@map("worship_plan_items")
}

// ============================================
// Communication Models (Phase 4)
// ============================================

enum MessageChannel {
  email
  sms
}

enum DeliveryStatus {
  pending
  sent
  failed
}

model Message {
  id              String         @id @default(cuid())
  channel         MessageChannel
  subject         String?
  body            String
  createdByUserId String         @map("created_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")

  // Relations
  createdByUser User               @relation(fields: [createdByUserId], references: [id])
  recipients    MessageRecipient[]

  @@index([createdAt])
  @@map("messages")
}

model MessageRecipient {
  id             String         @id @default(cuid())
  messageId      String         @map("message_id")
  memberId       String?        @map("member_id")
  guestContact   Json?          @map("guest_contact")
  deliveryStatus DeliveryStatus @default(pending) @map("delivery_status")
  deliveredAt    DateTime?      @map("delivered_at")
  errorMessage   String?        @map("error_message")

  // Relations
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  member  Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([deliveryStatus])
  @@map("message_recipients")
}

model MessageTemplate {
  id        String         @id @default(cuid())
  name      String
  channel   MessageChannel
  subject   String?
  body      String
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("message_templates")
}

model OptInPreference {
  id        String         @id @default(cuid())
  memberId  String         @map("member_id")
  channel   MessageChannel
  isOptedIn Boolean        @default(true) @map("is_opted_in")
  updatedAt DateTime       @updatedAt @map("updated_at")

  // Relations
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, channel])
  @@map("opt_in_preferences")
}

// ============================================
// Accounting + Giving Models (Phase 5)
// ============================================

enum PaymentMethod {
  cash
  check
  card
  online
  other
}

enum PledgeStatus {
  active
  completed
  canceled
}

enum InvoiceStatus {
  draft
  sent
  paid
  void
}

enum PurchaseOrderStatus {
  draft
  submitted
  approved
  rejected
  closed
  void
}

model Fund {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  isRestricted Boolean  @default(false) @map("is_restricted")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  donations Donation[]
  pledges   Pledge[]
  expenses  Expense[]

  @@map("funds")
}

model Donation {
  id            String        @id @default(cuid())
  memberId      String?       @map("member_id")
  guestName     String?       @map("guest_name")
  guestEmail    String?       @map("guest_email")
  amountCents   Int           @map("amount_cents")
  currency      String        @default("USD")
  fundId        String?       @map("fund_id")
  method        PaymentMethod
  receivedAt    DateTime      @map("received_at")
  note          String?
  // Stripe integration fields
  stripePaymentIntentId String?  @unique @map("stripe_payment_intent_id")
  stripeChargeId        String?  @unique @map("stripe_charge_id")
  stripeStatus          String?  @map("stripe_status")
  isOnline              Boolean  @default(false) @map("is_online")
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  fund   Fund?   @relation(fields: [fundId], references: [id], onDelete: SetNull)

  @@index([receivedAt])
  @@index([memberId])
  @@index([fundId])
  @@index([stripePaymentIntentId])
  @@map("donations")
}

model Pledge {
  id          String       @id @default(cuid())
  memberId    String       @map("member_id")
  fundId      String?      @map("fund_id")
  amountCents Int          @map("amount_cents")
  startDate   DateTime?    @map("start_date")
  endDate     DateTime?    @map("end_date")
  status      PledgeStatus @default(active)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fund   Fund?  @relation(fields: [fundId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([memberId])
  @@index([fundId])
  @@map("pledges")
}

model Vendor {
  id        String   @id @default(cuid())
  name      String   @unique
  email     String?
  phone     String?
  street    String?
  city      String?
  state     String?
  zip       String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  expenses       Expense[]
  invoices       Invoice[]
  purchaseOrders PurchaseOrder[]

  @@map("vendors")
}

model Expense {
  id          String   @id @default(cuid())
  vendorId    String?  @map("vendor_id")
  fundId      String?  @map("fund_id")
  amountCents Int      @map("amount_cents")
  currency    String   @default("USD")
  expenseDate DateTime @map("expense_date")
  category    String?
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  fund   Fund?   @relation(fields: [fundId], references: [id], onDelete: SetNull)

  @@index([expenseDate])
  @@index([vendorId])
  @@index([fundId])
  @@map("expenses")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique @map("invoice_number")
  vendorId      String?       @map("vendor_id")
  billToName    String?       @map("bill_to_name")
  issueDate     DateTime      @map("issue_date")
  dueDate       DateTime?     @map("due_date")
  status        InvoiceStatus @default(draft)
  subtotalCents Int           @map("subtotal_cents")
  taxCents      Int           @default(0) @map("tax_cents")
  totalCents    Int           @map("total_cents")
  note          String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  vendor Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  items  InvoiceItem[]

  @@index([status])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id             String @id @default(cuid())
  invoiceId      String @map("invoice_id")
  description    String
  quantity       Float
  unitPriceCents Int    @map("unit_price_cents")
  lineTotalCents Int    @map("line_total_cents")
  sortOrder      Int    @map("sort_order")

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  poNumber        String              @unique @map("po_number")
  vendorId        String?             @map("vendor_id")
  requestorUserId String?             @map("requestor_user_id")
  issueDate       DateTime            @map("issue_date")
  status          PurchaseOrderStatus @default(draft)
  subtotalCents   Int                 @map("subtotal_cents")
  taxCents        Int                 @default(0) @map("tax_cents")
  totalCents      Int                 @map("total_cents")
  note            String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  // Relations
  vendor        Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  requestorUser User?               @relation(fields: [requestorUserId], references: [id], onDelete: SetNull)
  items         PurchaseOrderItem[]

  @@index([status])
  @@index([issueDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String @map("purchase_order_id")
  description     String
  quantity        Float
  unitPriceCents  Int    @map("unit_price_cents")
  lineTotalCents  Int    @map("line_total_cents")
  sortOrder       Int    @map("sort_order")

  // Relations
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// ============================================
// Sales + Fundraising Models (Phase 6)
// ============================================

enum InventoryTransactionType {
  adjustment
  purchase
  sale
  return
}

enum SaleStatus {
  completed
  void
}

model Product {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  sku         String?  @unique
  priceCents  Int      @map("price_cents")
  currency    String   @default("USD")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  inventoryTransactions InventoryTransaction[]
  saleItems             SaleItem[]

  @@index([isActive])
  @@map("products")
}

model InventoryTransaction {
  id            String                   @id @default(cuid())
  productId     String                   @map("product_id")
  type          InventoryTransactionType
  quantityDelta Int                      @map("quantity_delta")
  note          String?
  createdAt     DateTime                 @default(now()) @map("created_at")

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model Sale {
  id              String     @id @default(cuid())
  saleNumber      String     @unique @map("sale_number")
  memberId        String?    @map("member_id")
  guestName       String?    @map("guest_name")
  status          SaleStatus @default(completed)
  subtotalCents   Int        @map("subtotal_cents")
  taxCents        Int        @default(0) @map("tax_cents")
  totalCents      Int        @map("total_cents")
  soldAt          DateTime   @map("sold_at")
  createdByUserId String     @map("created_by_user_id")
  createdAt       DateTime   @default(now()) @map("created_at")

  // Relations
  member        Member?    @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdByUser User       @relation(fields: [createdByUserId], references: [id])
  items         SaleItem[]

  @@index([saleNumber])
  @@index([soldAt])
  @@index([status])
  @@index([createdByUserId])
  @@map("sales")
}

model SaleItem {
  id             String @id @default(cuid())
  saleId         String @map("sale_id")
  productId      String @map("product_id")
  quantity       Int
  unitPriceCents Int    @map("unit_price_cents")
  lineTotalCents Int    @map("line_total_cents")
  sortOrder      Int    @map("sort_order")

  // Relations
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// ============================================
// Settings Models (Admin Settings Center)
// ============================================

model Setting {
  id        String   @id @default(cuid())
  category  String
  key       String
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([category, key])
  @@index([category])
  @@map("settings")
}

// ============================================
// Groups & Ministries Models
// ============================================

model Ministry {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  parentId    String?  @map("parent_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  parent   Ministry?  @relation("MinistryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Ministry[] @relation("MinistryHierarchy")
  groups   Group[]

  @@index([parentId])
  @@map("ministries")
}

model Group {
  id          String   @id @default(cuid())
  name        String
  ministryId  String   @map("ministry_id")
  description String?
  meetingDay  String?  @map("meeting_day")
  meetingTime String?  @map("meeting_time")
  location    String?
  capacity    Int?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  ministry Ministry      @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  members  GroupMember[]
  leaders  GroupLeader[]

  @@index([ministryId])
  @@map("groups")
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String   @map("group_id")
  memberId String   @map("member_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  // Relations
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberId])
  @@map("group_members")
}

model GroupLeader {
  id       String @id @default(cuid())
  groupId  String @map("group_id")
  memberId String @map("member_id")
  role     String @default("leader")

  // Relations
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberId])
  @@map("group_leaders")
}
