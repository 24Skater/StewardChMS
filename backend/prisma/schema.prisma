// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Tenancy (Phase 1 — the platform)
// ============================================

/// One church. `id` is the console's `orgId` — the same value in every Steward
/// application, minted by the console and never generated here. That is why it
/// has no `@default`: a row this app invented would be an organization the
/// platform has never heard of.
model Org {
  id        String    @id
  slug      String    @unique
  name      String
  status    OrgStatus @default(active)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  memberships             Membership[]
  userRoles               UserRole[]
  members                 Member[]
  households              Household[]
  householdMembers        HouseholdMember[]
  events                  Event[]
  eventOccurrences        EventOccurrence[]
  registrations           Registration[]
  checkIns                CheckIn[]
  songs                   Song[]
  worshipPlans            WorshipPlan[]
  worshipPlanItems        WorshipPlanItem[]
  messages                Message[]
  messageRecipients       MessageRecipient[]
  messageTemplates        MessageTemplate[]
  optInPreferences        OptInPreference[]
  funds                   Fund[]
  donations               Donation[]
  pledges                 Pledge[]
  vendors                 Vendor[]
  expenses                Expense[]
  invoices                Invoice[]
  purchaseOrders          PurchaseOrder[]
  products                Product[]
  inventoryTransactions   InventoryTransaction[]
  sales                   Sale[]
  settings                Setting[]
  ministries              Ministry[]
  groups                  Group[]
  groupMembers            GroupMember[]
  groupLeaders            GroupLeader[]
  ministryCalendars       MinistryCalendar[]
  calendarRotationMembers CalendarRotationMember[]
  schedulePeriods         SchedulePeriod[]
  scheduleSlots           ScheduleSlot[]
  slotAssignments         SlotAssignment[]
  auditLogs               AuditLog[]

  @@map("orgs")
}

enum OrgStatus {
  active
  suspended
}

/// A person's link to one church. `User` is deliberately global — one human has
/// one login across every church they serve — so everything church-shaped about
/// them (their roles, whether they are its owner) hangs off this row instead.
model Membership {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  userId    String   @map("user_id")
  isOwner   Boolean  @default(false) @map("is_owner")
  createdAt DateTime @default(now()) @map("created_at")

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

// ============================================
// Auth + RBAC Models (Phase 1)
// ============================================

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  passwordHash   String   @map("password_hash")
  isActive       Boolean  @default(true) @map("is_active")
  isPrimaryAdmin Boolean  @default(false) @map("is_primary_admin")
  isSeedAccount  Boolean  @default(false) @map("is_seed_account")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  userRoles           UserRole[]
  auditLogs           AuditLog[]           @relation("ActorAuditLogs")
  messages            Message[]
  purchaseOrders      PurchaseOrder[]
  sales               Sale[]
  createdCalendars    MinistryCalendar[]   @relation("CalendarCreatedBy")
  assignedSlots       SlotAssignment[]     @relation("AssignedBy")
  passwordResetTokens PasswordResetToken[]
  memberships         Membership[]

  @@map("users")
}

/// A token that has been logged out, until it would have expired anyway.
///
/// This used to be an array in one process's memory, which was correct on one
/// process and wrong on two: a second instance never heard about the logout, so
/// the "revoked" token kept working there for up to seven days. It is a table
/// because Congregation already has a database and does not already have a
/// Redis, and one more piece of infrastructure to run is a real cost for a
/// self-hosted church.
///
/// Rows are deleted once `expiresAt` has passed. Keeping them would grow the
/// table forever to prevent the reuse of tokens that no longer verify.
model RevokedToken {
  /// The token's `jti` claim. The token itself is never stored - it is a
  /// credential, and this table would otherwise be a list of working ones.
  jti       String   @id
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime @default(now()) @map("revoked_at")

  @@index([expiresAt])
  @@map("revoked_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  orgId  String @map("org_id")
  userId String @map("user_id")
  roleId String @map("role_id")

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // A role grant is per organization: the same person may be an administrator
  // of one church and a volunteer in another.
  @@id([orgId, userId, roleId])
  @@index([orgId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id          String   @id @default(cuid())
  orgId       String   @map("org_id")
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  actorUser User? @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)
  org       Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
  @@index([orgId])
  @@map("audit_logs")
}

// ============================================
// Member CRM Models (Phase 2)
// ============================================

model Member {
  id              String       @id @default(cuid())
  orgId           String       @map("org_id")
  firstName       String       @map("first_name")
  lastName        String       @map("last_name")
  email           String?
  phone           String?
  street          String?
  city            String?
  state           String?
  zip             String?
  dateOfBirth     DateTime?    @map("date_of_birth")
  status          MemberStatus @default(active)
  notes           String? // Permission restricted (members.notes)
  profilePhotoUrl String?      @map("profile_photo_url")
  // Kids Check-in fields
  isChild         Boolean      @default(false) @map("is_child")
  securityCode    String?      @map("security_code")
  allergies       String?
  medicalNotes    String?      @map("medical_notes")
  parentalNotes   String?      @map("parental_notes")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  householdMembers    HouseholdMember[]
  registrations       Registration[]
  checkIns            CheckIn[]
  worshipPlanItems    WorshipPlanItem[]
  messageRecipients   MessageRecipient[]
  optInPreferences    OptInPreference[]
  donations           Donation[]
  pledges             Pledge[]
  sales               Sale[]
  groupMemberships    GroupMember[]
  groupLeaderships    GroupLeader[]
  rotationMemberships CalendarRotationMember[]
  slotAssignments     SlotAssignment[]
  org                 Org                      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@unique([orgId, securityCode])
  @@index([lastName])
  @@index([email])
  @@index([status])
  @@index([orgId])
  @@map("members")
}

enum MemberStatus {
  active
  inactive
  visitor
}

model Household {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  members HouseholdMember[]
  org     Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("households")
}

model HouseholdMember {
  id               String           @id @default(cuid())
  orgId            String           @map("org_id")
  householdId      String           @map("household_id")
  memberId         String           @map("member_id")
  relationshipType RelationshipType @map("relationship_type")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  org       Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([householdId, memberId])
  @@index([householdId])
  @@index([memberId])
  @@index([orgId])
  @@map("household_members")
}

enum RelationshipType {
  parent
  child
  spouse
  other
}

// ============================================
// Events Models (Phase 3)
// ============================================

model Event {
  id             String    @id @default(cuid())
  orgId          String    @map("org_id")
  title          String
  description    String?
  location       String?
  category       String?
  ministryId     String?   @map("ministry_id")
  isRecurring    Boolean   @default(false) @map("is_recurring")
  recurrenceRule String?   @map("recurrence_rule")
  startDatetime  DateTime? @map("start_datetime")
  endDatetime    DateTime? @map("end_datetime")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  occurrences EventOccurrence[]
  org         Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([startDatetime])
  @@index([orgId])
  @@map("events")
}

model EventOccurrence {
  id       String           @id @default(cuid())
  orgId    String           @map("org_id")
  eventId  String           @map("event_id")
  startsAt DateTime         @map("starts_at")
  endsAt   DateTime?        @map("ends_at")
  status   OccurrenceStatus @default(scheduled)
  notes    String?

  // Relations
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]
  checkIns      CheckIn[]
  worshipPlan   WorshipPlan?
  scheduleSlots ScheduleSlot[]
  org           Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([eventId, startsAt])
  @@index([startsAt])
  @@index([eventId])
  @@index([orgId])
  @@map("event_occurrences")
}

enum OccurrenceStatus {
  scheduled
  canceled
}

model Registration {
  id                String             @id @default(cuid())
  orgId             String             @map("org_id")
  eventOccurrenceId String             @map("event_occurrence_id")
  memberId          String?            @map("member_id")
  guestName         String?            @map("guest_name")
  guestEmail        String?            @map("guest_email")
  guestPhone        String?            @map("guest_phone")
  partySize         Int                @default(1) @map("party_size")
  status            RegistrationStatus @default(registered)
  createdAt         DateTime           @default(now()) @map("created_at")

  // Relations
  occurrence EventOccurrence @relation(fields: [eventOccurrenceId], references: [id], onDelete: Cascade)
  member     Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)
  org        Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([eventOccurrenceId])
  @@index([memberId])
  @@index([orgId])
  @@map("registrations")
}

enum RegistrationStatus {
  registered
  canceled
}

model CheckIn {
  id                String    @id @default(cuid())
  orgId             String    @map("org_id")
  eventOccurrenceId String    @map("event_occurrence_id")
  memberId          String?   @map("member_id")
  guestName         String?   @map("guest_name")
  checkedInAt       DateTime  @default(now()) @map("checked_in_at")
  checkedOutAt      DateTime? @map("checked_out_at")
  method            String    @default("manual")

  // Relations
  occurrence EventOccurrence @relation(fields: [eventOccurrenceId], references: [id], onDelete: Cascade)
  member     Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)
  org        Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([eventOccurrenceId])
  @@index([memberId])
  @@index([orgId])
  @@map("check_ins")
}

// ============================================
// Worship Planning Models (Phase 3)
// ============================================

model Song {
  id         String   @id @default(cuid())
  orgId      String   @map("org_id")
  title      String
  artist     String?
  defaultKey String?  @map("default_key")
  bpm        Int?
  lyrics     String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  worshipPlanItems WorshipPlanItem[]
  org              Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([title])
  @@index([orgId])
  @@map("songs")
}

model WorshipPlan {
  id                String   @id @default(cuid())
  orgId             String   @map("org_id")
  eventOccurrenceId String   @unique @map("event_occurrence_id")
  title             String?
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  occurrence EventOccurrence   @relation(fields: [eventOccurrenceId], references: [id], onDelete: Cascade)
  items      WorshipPlanItem[]
  org        Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("worship_plans")
}

model WorshipPlanItem {
  id               String  @id @default(cuid())
  orgId            String  @map("org_id")
  worshipPlanId    String  @map("worship_plan_id")
  sortOrder        Int     @map("sort_order")
  itemType         String  @map("item_type")
  title            String
  details          String?
  songId           String? @map("song_id")
  assignedMemberId String? @map("assigned_member_id")
  durationMinutes  Int?    @map("duration_minutes")

  // Relations
  worshipPlan    WorshipPlan @relation(fields: [worshipPlanId], references: [id], onDelete: Cascade)
  song           Song?       @relation(fields: [songId], references: [id], onDelete: SetNull)
  assignedMember Member?     @relation(fields: [assignedMemberId], references: [id], onDelete: SetNull)
  org            Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([worshipPlanId])
  @@index([songId])
  @@index([orgId])
  @@map("worship_plan_items")
}

// ============================================
// Communication Models (Phase 4)
// ============================================

enum MessageChannel {
  email
  sms
}

enum DeliveryStatus {
  pending
  sent
  failed
}

model Message {
  id              String         @id @default(cuid())
  orgId           String         @map("org_id")
  channel         MessageChannel
  subject         String?
  body            String
  createdByUserId String         @map("created_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")

  // Relations
  createdByUser User               @relation(fields: [createdByUserId], references: [id])
  recipients    MessageRecipient[]
  org           Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([orgId])
  @@map("messages")
}

model MessageRecipient {
  id             String         @id @default(cuid())
  orgId          String         @map("org_id")
  messageId      String         @map("message_id")
  memberId       String?        @map("member_id")
  guestContact   Json?          @map("guest_contact")
  deliveryStatus DeliveryStatus @default(pending) @map("delivery_status")
  deliveredAt    DateTime?      @map("delivered_at")
  errorMessage   String?        @map("error_message")

  // Relations
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  member  Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  org     Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([deliveryStatus])
  @@index([orgId])
  @@map("message_recipients")
}

model MessageTemplate {
  id        String         @id @default(cuid())
  orgId     String         @map("org_id")
  name      String
  channel   MessageChannel
  subject   String?
  body      String
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  org       Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("message_templates")
}

model OptInPreference {
  id        String         @id @default(cuid())
  orgId     String         @map("org_id")
  memberId  String         @map("member_id")
  channel   MessageChannel
  isOptedIn Boolean        @default(true) @map("is_opted_in")
  updatedAt DateTime       @updatedAt @map("updated_at")

  // Relations
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([memberId, channel])
  @@index([orgId])
  @@map("opt_in_preferences")
}

// ============================================
// Accounting + Giving Models (Phase 5)
// ============================================

enum PaymentMethod {
  cash
  check
  card
  online
  other
}

enum PledgeStatus {
  active
  completed
  canceled
}

enum InvoiceStatus {
  draft
  sent
  paid
  void
}

enum PurchaseOrderStatus {
  draft
  submitted
  approved
  rejected
  closed
  void
}

model Fund {
  id           String   @id @default(cuid())
  orgId        String   @map("org_id")
  name         String
  description  String?
  isRestricted Boolean  @default(false) @map("is_restricted")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  donations Donation[]
  pledges   Pledge[]
  expenses  Expense[]
  org       Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId])
  @@map("funds")
}

model Donation {
  id                    String        @id @default(cuid())
  orgId                 String        @map("org_id")
  memberId              String?       @map("member_id")
  guestName             String?       @map("guest_name")
  guestEmail            String?       @map("guest_email")
  amountCents           Int           @map("amount_cents")
  currency              String        @default("USD")
  fundId                String?       @map("fund_id")
  method                PaymentMethod
  receivedAt            DateTime      @map("received_at")
  note                  String?
  // Stripe integration fields
  stripePaymentIntentId String?       @unique @map("stripe_payment_intent_id")
  stripeChargeId        String?       @unique @map("stripe_charge_id")
  stripeStatus          String?       @map("stripe_status")
  isOnline              Boolean       @default(false) @map("is_online")
  createdAt             DateTime      @default(now()) @map("created_at")

  // Relations
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  fund   Fund?   @relation(fields: [fundId], references: [id], onDelete: SetNull)
  org    Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([receivedAt])
  @@index([memberId])
  @@index([fundId])
  @@index([stripePaymentIntentId])
  @@index([orgId])
  @@map("donations")
}

model Pledge {
  id          String       @id @default(cuid())
  orgId       String       @map("org_id")
  memberId    String       @map("member_id")
  fundId      String?      @map("fund_id")
  amountCents Int          @map("amount_cents")
  startDate   DateTime?    @map("start_date")
  endDate     DateTime?    @map("end_date")
  status      PledgeStatus @default(active)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fund   Fund?  @relation(fields: [fundId], references: [id], onDelete: SetNull)
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([memberId])
  @@index([fundId])
  @@index([orgId])
  @@map("pledges")
}

model Vendor {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  name      String
  email     String?
  phone     String?
  street    String?
  city      String?
  state     String?
  zip       String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  expenses       Expense[]
  invoices       Invoice[]
  purchaseOrders PurchaseOrder[]
  org            Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId])
  @@map("vendors")
}

model Expense {
  id          String   @id @default(cuid())
  orgId       String   @map("org_id")
  vendorId    String?  @map("vendor_id")
  fundId      String?  @map("fund_id")
  amountCents Int      @map("amount_cents")
  currency    String   @default("USD")
  expenseDate DateTime @map("expense_date")
  category    String?
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  fund   Fund?   @relation(fields: [fundId], references: [id], onDelete: SetNull)
  org    Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([expenseDate])
  @@index([vendorId])
  @@index([fundId])
  @@index([orgId])
  @@map("expenses")
}

model Invoice {
  id            String        @id @default(cuid())
  orgId         String        @map("org_id")
  invoiceNumber String        @map("invoice_number")
  vendorId      String?       @map("vendor_id")
  billToName    String?       @map("bill_to_name")
  issueDate     DateTime      @map("issue_date")
  dueDate       DateTime?     @map("due_date")
  status        InvoiceStatus @default(draft)
  subtotalCents Int           @map("subtotal_cents")
  taxCents      Int           @default(0) @map("tax_cents")
  totalCents    Int           @map("total_cents")
  note          String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  vendor Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  items  InvoiceItem[]
  org    Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, invoiceNumber])
  @@index([status])
  @@index([issueDate])
  @@index([orgId])
  @@map("invoices")
}

model InvoiceItem {
  id             String @id @default(cuid())
  invoiceId      String @map("invoice_id")
  description    String
  quantity       Float
  unitPriceCents Int    @map("unit_price_cents")
  lineTotalCents Int    @map("line_total_cents")
  sortOrder      Int    @map("sort_order")

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  orgId           String              @map("org_id")
  poNumber        String              @map("po_number")
  vendorId        String?             @map("vendor_id")
  requestorUserId String?             @map("requestor_user_id")
  issueDate       DateTime            @map("issue_date")
  status          PurchaseOrderStatus @default(draft)
  subtotalCents   Int                 @map("subtotal_cents")
  taxCents        Int                 @default(0) @map("tax_cents")
  totalCents      Int                 @map("total_cents")
  note            String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  // Relations
  vendor        Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  requestorUser User?               @relation(fields: [requestorUserId], references: [id], onDelete: SetNull)
  items         PurchaseOrderItem[]
  org           Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, poNumber])
  @@index([status])
  @@index([issueDate])
  @@index([orgId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String @map("purchase_order_id")
  description     String
  quantity        Float
  unitPriceCents  Int    @map("unit_price_cents")
  lineTotalCents  Int    @map("line_total_cents")
  sortOrder       Int    @map("sort_order")

  // Relations
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// ============================================
// Sales + Fundraising Models (Phase 6)
// ============================================

enum InventoryTransactionType {
  adjustment
  purchase
  sale
  return
}

enum SaleStatus {
  completed
  void
}

model Product {
  id          String   @id @default(cuid())
  orgId       String   @map("org_id")
  name        String
  description String?
  sku         String?
  priceCents  Int      @map("price_cents")
  currency    String   @default("USD")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  inventoryTransactions InventoryTransaction[]
  saleItems             SaleItem[]
  org                   Org                    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@unique([orgId, sku])
  @@index([isActive])
  @@index([orgId])
  @@map("products")
}

model InventoryTransaction {
  id            String                   @id @default(cuid())
  orgId         String                   @map("org_id")
  productId     String                   @map("product_id")
  type          InventoryTransactionType
  quantityDelta Int                      @map("quantity_delta")
  note          String?
  createdAt     DateTime                 @default(now()) @map("created_at")

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  org     Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
  @@index([orgId])
  @@map("inventory_transactions")
}

model Sale {
  id              String     @id @default(cuid())
  orgId           String     @map("org_id")
  saleNumber      String     @map("sale_number")
  memberId        String?    @map("member_id")
  guestName       String?    @map("guest_name")
  status          SaleStatus @default(completed)
  subtotalCents   Int        @map("subtotal_cents")
  taxCents        Int        @default(0) @map("tax_cents")
  totalCents      Int        @map("total_cents")
  soldAt          DateTime   @map("sold_at")
  createdByUserId String     @map("created_by_user_id")
  createdAt       DateTime   @default(now()) @map("created_at")

  // Relations
  member        Member?    @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdByUser User       @relation(fields: [createdByUserId], references: [id])
  items         SaleItem[]
  org           Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, saleNumber])
  @@index([saleNumber])
  @@index([soldAt])
  @@index([status])
  @@index([createdByUserId])
  @@index([orgId])
  @@map("sales")
}

model SaleItem {
  id             String @id @default(cuid())
  saleId         String @map("sale_id")
  productId      String @map("product_id")
  quantity       Int
  unitPriceCents Int    @map("unit_price_cents")
  lineTotalCents Int    @map("line_total_cents")
  sortOrder      Int    @map("sort_order")

  // Relations
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// ============================================
// Settings Models (Admin Settings Center)
// ============================================

model Setting {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  category  String
  key       String
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, category, key], name: "org_category_key")
  @@index([category])
  @@index([orgId])
  @@map("settings")
}

// ============================================
// Groups & Ministries Models
// ============================================

model Ministry {
  id          String   @id @default(cuid())
  orgId       String   @map("org_id")
  name        String
  description String?
  parentId    String?  @map("parent_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  parent    Ministry?          @relation("MinistryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Ministry[]         @relation("MinistryHierarchy")
  groups    Group[]
  calendars MinistryCalendar[]
  org       Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([parentId])
  @@index([orgId])
  @@map("ministries")
}

model Group {
  id          String   @id @default(cuid())
  orgId       String   @map("org_id")
  name        String
  ministryId  String   @map("ministry_id")
  description String?
  meetingDay  String?  @map("meeting_day")
  meetingTime String?  @map("meeting_time")
  location    String?
  capacity    Int?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  ministry Ministry      @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  members  GroupMember[]
  leaders  GroupLeader[]
  org      Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([ministryId])
  @@index([orgId])
  @@map("groups")
}

model GroupMember {
  id       String   @id @default(cuid())
  orgId    String   @map("org_id")
  groupId  String   @map("group_id")
  memberId String   @map("member_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  // Relations
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberId])
  @@index([orgId])
  @@map("group_members")
}

model GroupLeader {
  id       String @id @default(cuid())
  orgId    String @map("org_id")
  groupId  String @map("group_id")
  memberId String @map("member_id")
  role     String @default("leader")

  // Relations
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberId])
  @@index([orgId])
  @@map("group_leaders")
}

// ============================================
// Ministry Scheduling Models (Phase 7)
// ============================================

enum SchedulePeriodStatus {
  DRAFT
  PUBLISHED
}

model MinistryCalendar {
  id                     String   @id @default(cuid())
  orgId                  String   @map("org_id")
  name                   String
  description            String?
  ministryId             String   @map("ministry_id")
  shareToken             String   @unique @map("share_token")
  reminderDaysBeforeSlot Int      @default(2) @map("reminder_days_before_slot")
  serviceDayOfWeek       Int      @default(0) @map("service_day_of_week")
  rotationNextIndex      Int      @default(0) @map("rotation_next_index")
  isActive               Boolean  @default(true) @map("is_active")
  createdById            String   @map("created_by_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  // Relations
  ministry        Ministry                 @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  createdBy       User                     @relation("CalendarCreatedBy", fields: [createdById], references: [id])
  rotationMembers CalendarRotationMember[]
  periods         SchedulePeriod[]
  org             Org                      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([ministryId])
  @@index([shareToken])
  @@index([orgId])
  @@map("ministry_calendars")
}

model CalendarRotationMember {
  id            String @id @default(cuid())
  orgId         String @map("org_id")
  calendarId    String @map("calendar_id")
  memberId      String @map("member_id")
  rotationOrder Int    @map("rotation_order")

  // Relations
  calendar MinistryCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  member   Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  org      Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([calendarId, memberId])
  @@unique([calendarId, rotationOrder])
  @@index([calendarId])
  @@index([orgId])
  @@map("calendar_rotation_members")
}

model SchedulePeriod {
  id         String               @id @default(cuid())
  orgId      String               @map("org_id")
  calendarId String               @map("calendar_id")
  year       Int
  month      Int
  status     SchedulePeriodStatus @default(DRAFT)
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  // Relations
  calendar MinistryCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  slots    ScheduleSlot[]
  org      Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([calendarId, year, month])
  @@index([calendarId])
  @@index([orgId])
  @@map("schedule_periods")
}

model ScheduleSlot {
  id                String   @id @default(cuid())
  orgId             String   @map("org_id")
  periodId          String   @map("period_id")
  slotDate          DateTime @map("slot_date")
  label             String?
  eventOccurrenceId String?  @map("event_occurrence_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  period          SchedulePeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  eventOccurrence EventOccurrence? @relation(fields: [eventOccurrenceId], references: [id], onDelete: SetNull)
  assignment      SlotAssignment?
  org             Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([periodId])
  @@index([slotDate])
  @@index([orgId])
  @@map("schedule_slots")
}

model SlotAssignment {
  id             String    @id @default(cuid())
  orgId          String    @map("org_id")
  slotId         String    @unique @map("slot_id")
  memberId       String    @map("member_id")
  assignedById   String    @map("assigned_by_id")
  notifiedAt     DateTime? @map("notified_at")
  reminderSentAt DateTime? @map("reminder_sent_at")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  slot       ScheduleSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  member     Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  assignedBy User         @relation("AssignedBy", fields: [assignedById], references: [id])
  org        Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([slotId])
  @@index([orgId])
  @@map("slot_assignments")
}
