# Docker Environment Variables
# Copy this to .env and customize for your deployment
# cp docker.env.example .env

# Database
POSTGRES_USER=steward
POSTGRES_PASSWORD=steward123
POSTGRES_DB=stewardchms

# JWT - CHANGE THIS IN PRODUCTION!
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=7d

# CORS (set to your frontend URL in production)
CORS_ORIGIN=http://localhost

# Admin User (created on first seed)
ADMIN_EMAIL=admin@stewardchms.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=System Administrator


# Steward platform (leave both blank for a self-hosted install)
#
# Blank is the supported default. Without a root domain this app resolves its
# single organization from the database and behaves exactly as it always has —
# a church running its own copy has no console to ask and must not need one.
#
# Set both to have the Steward console provision churches into this deployment.
# The root domain is what turns host-based organization resolution on, so
# requests arrive at {slug}-stewardchms.app.<root>; the service token is what
# the console presents to POST /api/internal/provision, and without it that
# endpoint refuses every call.
PLATFORM_ROOT_DOMAIN=
PLATFORM_SERVICE_TOKEN=

# ── Single sign-on (optional) ────────────────────────────────────────────────
#
# One identity provider across the Steward applications, so somebody who serves
# at a church using Congregation and Table signs in once rather than twice.
#
# Unset, the SSO routes answer 404, the sign-in page shows only the password
# form, and nothing else behaves differently. A church running Congregation on
# its own server never needs any of it.
#
# Create a Regular Web Application at the identity provider and set its callback
# URL to https://<this-host>/api/auth/sso/callback
AUTH0_ISSUER=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# What the sign-in button says.
# AUTH0_BUTTON_LABEL=Continue with Steward ID

# Email-and-password sign-in. Defaults to on, and password_hash is never
# dropped. Set to "false" only once single sign-on is proven for everybody who
# needs to get in - it is a deliberate act, not a default.
# ALLOW_LOCAL_PASSWORD_LOGIN=true
